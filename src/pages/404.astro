---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" description="This page doesn't exist on Calcio Inglese.">
  <div class="wrap notfound">
    <h1>404</h1>
    <p>That page doesn't exist.</p>
    <a href="/">Back to the homepage →</a>
  </div>
</Layout>

<style>
  .notfound { padding: 80px 0; text-align: center; }
  h1 { font-family: 'Archivo Black', sans-serif; font-size: 64px; color: var(--navy); }
  p { color: var(--gray); margin: 12px 0 20px; }
  a { color: var(--green-dark); font-weight: 700; }
</style>
