---
import { getCollection } from 'astro:content';
import NewsGridPage from '../../../../components/NewsGridPage.astro';
import { slugify } from '../../../../utils/slugify';

export async function getStaticPaths() {
  const allNews = await getCollection('news', ({ data }) => !data.draft);
  const tags = Array.from(new Set(allNews.flatMap((a) => a.data.tags)));

  return tags.map((tag) => {
    const entries = allNews
      .filter((a) => a.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
    return {
      params: { tag: slugify(tag) },
      props: { tag, entries },
    };
  });
}

const { tag, entries } = Astro.props;
---

<NewsGridPage
  title={`#${tag} — Premier League News`}
  description={`Premier League stories tagged ${tag} from Calcio Inglese.`}
  heading={`#${tag}`}
  entries={entries}
/>
