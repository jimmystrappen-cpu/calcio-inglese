---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Get in touch with the Calcio Inglese editorial team."
>
  <div class="wrap page">
    <h1>Contact</h1>
    <p>For editorial queries, corrections or feedback, email us at <a class="email" href="mailto:editor@calcioinglese.org">editor@calcioinglese.org</a>.</p>
  </div>
</Layout>

<style>
  .page { padding: 30px 0 60px; max-width: 680px; }
  h1 { font-family: 'Archivo Black', sans-serif; font-size: 28px; margin-bottom: 18px; }
  p { line-height: 1.7; color: var(--ink); }
  .email { color: var(--green-dark); font-weight: 600; }
</style>
