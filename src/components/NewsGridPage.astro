---
// Shared layout for /news/, /news/[category]/ and /news/tag/[tag]/
import Layout from '../layouts/Layout.astro';
import ArticleCard from './ArticleCard.astro';

export interface Props {
  title: string;
  description: string;
  heading: string;
  entries: { id: string; data: any }[];
}

const { title, description, heading, entries } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="wrap listing-page">
    <h1>{heading}</h1>
    {entries.length === 0 ? (
      <p class="empty">No articles yet — check back soon.</p>
    ) : (
      <div class="news-grid">
        {entries.map((item) => (
          <ArticleCard {...item.data} slug={item.id} size="grid" />
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  .listing-page { padding: 30px 0 60px; }
  h1 { font-family: 'Archivo Black', sans-serif; font-size: 28px; margin-bottom: 24px; }
  .news-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .empty { color: var(--gray); }
  @media (max-width: 860px) {
    .news-grid { grid-template-columns: 1fr; }
  }
</style>
